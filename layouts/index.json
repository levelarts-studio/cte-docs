{{/* Hugo Home JSON Output */}}
{{- $pages := where site.RegularPages "Params.entity" "in" (slice "module" "assignment") -}}
{{- $output := slice -}}
{{- range $pages -}}
  {{- $output = $output | append (dict "id" .Params.id "title" .Title "entity" .Params.entity "subject" .Params.subject "tier" .Params.tier "status" .Params.status "relpermalink" .RelPermalink "standards" .Params.standards "keywords" .Params.keywords) -}}
{{- end -}}
{{- $output | jsonify -}}
